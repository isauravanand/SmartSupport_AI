# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Google Gemini API Configuration (Primary Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (Automatic Fallback Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Bolna.ai Automated Voice Agent Configuration
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Configured Business Support Phone Number
SUPPORT_PHONE_NUMBER=+91 (800) 555-8722
