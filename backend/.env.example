# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Google Gemini API Configuration (Official @google/genai SDK - Primary Provider)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (Automatic Fallback Provider when Gemini rate limit or quota hits)
# Obtain key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Bolna.ai Automated Voice Agent Configuration
# Obtain API key and Agent ID from Bolna dashboard: https://bolna.ai/
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Configured Business Support Phone Number (Displayed on website & linked to Bolna inbound calls)
SUPPORT_PHONE_NUMBER=+91 (800) 555-8722
